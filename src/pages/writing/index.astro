---
import Base from '../../layouts/Base.astro';
import PageNav from '../../components/PageNav.astro';
import PostList from '../../components/PostList.astro';
import { profile } from '../../data/profile.js';
import { getPublishedPosts } from '../../lib/posts.js';

const posts = await getPublishedPosts();
---

<Base
  title={`Writing — ${profile.name}`}
  description="Rafa Gomes on running agentic AI in production: measuring cost and usage, spec-driven delivery, and building AI-native engineering teams."
  noindex={posts.length === 0}
>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="wrap"><PageNav /></div>
  <main id="main" class="wrap writing">
    <h1>Writing</h1>
    {posts.length > 0
      ? <PostList posts={posts} />
      : <p>Nothing published yet.</p>}
  </main>
</Base>
