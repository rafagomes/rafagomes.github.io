---
// Layout follows the "Resume — Web" artboard in the Paper file "Resume".
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile.js';

const [featured, ...smallProjects] = profile.projects;
const socials = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'GitHub', href: profile.links.github },
  { label: 'X', href: profile.links.twitter },
  { label: 'Telegram', href: profile.links.telegram },
  { label: '0xrafasec', href: profile.links.blog },
];
---

<Base>
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="wrap">
    <nav aria-label="Primary">
      <a class="mark" href="/">RG<span>.</span></a>
      <ul>
        <li><a href="#impact">Impact</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#work">Work</a></li>
        <li><a class="cta" href="/resume.pdf" download>Download PDF ↓</a></li>
      </ul>
    </nav>

    <header class="hero">
      <p class="status">{profile.status}</p>
      <h1>{profile.name}</h1>
      <div class="hero-foot">
        <p class="tagline">I take agentic AI from <span class="accent">demo to production</span> — and build the teams that ship it.</p>
        <p class="hero-meta">
          {profile.title} at {profile.company}. {profile.impact[0].value} years in software. {profile.location} ({profile.timezone}), working globally.
        </p>
      </div>
    </header>
  </div>

  <main id="main">
    <section class="band" id="impact" aria-labelledby="impact-title">
      <h2 id="impact-title" class="visually-hidden">Impact</h2>
      <ul class="wrap">
        {profile.impact.map((i) => <li><strong>{i.value}</strong><span>{i.label}</span></li>)}
      </ul>
    </section>

    <div class="wrap">
      <section class="sides">
        <div class="sides-head">
          <p class="label accent">Both sides of agentic AI</p>
          <h2>Demos are easy. Production is the job.</h2>
        </div>
        <div class="sides-cols">
          {profile.sides.map((s) => (
            <div class="side">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="experience" id="experience">
        <div class="section-head">
          <h2>Experience</h2>
          <p class="label accent">{profile.startYear} — now</p>
        </div>
        {profile.experience.map((job) => (
          <article class={job.major ? 'role major' : 'role'}>
            <p class="period">{job.period}</p>
            <div>
              <h3>{job.role}</h3>
              <p class="org">{job.company}{job.note && ` · ${job.note}`}</p>
            </div>
            <p>{job.summary}</p>
          </article>
        ))}
      </section>

      <section class="work" id="work">
        <h2>Building in the open</h2>
        <div class="cards">
          <div class="card dark">
            <p class="label">{featured.kind}</p>
            <h3><a href={featured.url}>{featured.name}</a></h3>
            <p>{featured.description}</p>
            <ul class="more">
              {smallProjects.map((p) => (
                <li><a href={p.url}>{p.name}</a> <span>{p.kind} — {p.description}</span></li>
              ))}
            </ul>
          </div>
          <div class="card line">
            <p class="label accent">Security research</p>
            <h3><a href={profile.links.blog}>0xrafasec</a></h3>
            <p>Ethical hacking and threat modeling background. I write about how real systems fail:</p>
            <ul class="topics">
              {profile.writing.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="details" aria-labelledby="details-title">
        <h2 id="details-title" class="visually-hidden">Skills and background</h2>
        <div>
          <h3 class="label">Stack</h3>
          <p>{profile.stack}</p>
          <p class="dim">{profile.focus}</p>
        </div>
        <div>
          <h3 class="label">Education</h3>
          {profile.education.map((e) => <p>{e.credential} <span class="dim">— {e.issuer}, {e.period}</span></p>)}
        </div>
        <div>
          <h3 class="label">Certifications</h3>
          {profile.certifications.map((c) => <p>{c.name} <span class="dim">— {c.issuer}, {c.year}</span></p>)}
          <p class="dim">Award — {profile.award}</p>
        </div>
        <div>
          <h3 class="label">Languages</h3>
          {profile.languages.map((l) => <p>{l}</p>)}
        </div>
      </section>

      <footer>
        <div>
          <p class="label accent">Hard problems welcome</p>
          <p class="big">Let's talk.</p>
        </div>
        <ul aria-label="Elsewhere">
          {socials.map((s) => <li><a href={s.href} rel="me">{s.label} ↗</a></li>)}
        </ul>
      </footer>
    </div>
  </main>
</Base>
