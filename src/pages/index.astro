---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile.js';

const year = new Date().getFullYear();
const [brandName, ...brandTld] = profile.domain.split('.');
---

<Base>
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand">{brandName}<span class="dot">.{brandTld.join('.')}</span></a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <p class="hero-eyebrow"><span class="status-dot"></span>{profile.title} @ {profile.company}</p>
        <h1>{profile.name}<br /><span class="accent">AI engineering leader.</span></h1>
        <p class="hero-lede">{profile.tagline}</p>
        <div class="hero-meta">
          <span>📍 {profile.location}</span>
          <span>🕑 {profile.timezone}</span>
          <span>🌐 EN · PT</span>
          <span>⏳ 18+ years shipping software</span>
        </div>
        <div class="cta-row">
          <a class="btn btn-primary" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn" href={profile.links.blog} target="_blank" rel="noopener">Writing ↗</a>
          <a class="btn" href="#contact">Get in touch</a>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section">
      <div class="wrap">
        <p class="section-label">01 / About</p>
        <h2>Building AI systems that hold up in production.</h2>
        <div class="about-grid">
          {profile.about.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="section">
      <div class="wrap">
        <p class="section-label">02 / Capabilities</p>
        <h2>What I work with.</h2>
        <div class="skills-grid">
          {profile.skills.map((group) => (
            <div class="skill-card">
              <h3>{group.group}</h3>
              <ul class="tag-list">
                {group.items.map((item) => <li class="tag">{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="section">
      <div class="wrap">
        <p class="section-label">03 / Experience</p>
        <h2>Where I've delivered.</h2>
        <div class="timeline">
          {profile.experience.map((job) => (
            <article class="tl-item">
              <div class="tl-period">{job.period}</div>
              <div class="tl-body">
                <h3>{job.role} · <span class="tl-company">{job.company}</span></h3>
                <p>{job.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="section">
      <div class="wrap">
        <p class="section-label">04 / Selected work</p>
        <h2>Open-source & projects.</h2>
        <div class="projects-grid">
          {profile.projects.map((proj) => (
            <a
              class={proj.featured ? 'project-card featured' : 'project-card'}
              href={proj.url}
              target="_blank"
              rel="noopener"
            >
              {proj.featured && <span class="featured-flag">★ Featured</span>}
              <div class="project-head">
                <h3>{proj.name}</h3>
                <span class="project-lang">{proj.language}</span>
              </div>
              <p>{proj.description}</p>
              <span class="project-link">View on GitHub ↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- WRITING -->
    <section id="writing" class="section">
      <div class="wrap">
        <p class="section-label">05 / Writing</p>
        <h2>Security research & deep-dives.</h2>
        <p style="color:var(--text-dim);max-width:56ch;margin:-1rem 0 2rem">
          I publish security research as <a href={profile.links.blog} target="_blank" rel="noopener" style="color:var(--accent)">0xrafasec</a> — CVE deep-dives, malware analysis, and blockchain security.
        </p>
        <div class="writing-list">
          {profile.writing.map((post) => (
            <a class="writing-item" href={profile.links.blog} target="_blank" rel="noopener">
              <h3>{post.title}</h3>
              <span class="writing-topic">{post.topic}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CREDENTIALS -->
    <section id="credentials" class="section">
      <div class="wrap">
        <p class="section-label">06 / Credentials</p>
        <h2>Education & certifications.</h2>
        <div class="cred-grid">
          <div>
            <h3>Education</h3>
            {profile.education.map((e) => (
              <div class="cred-item">
                <strong>{e.credential}</strong>
                <span>{e.issuer} · {e.period}</span>
              </div>
            ))}
          </div>
          <div>
            <h3>Certifications</h3>
            {profile.certifications.map((c) => (
              <div class="cred-item">
                <strong>{c.name}</strong>
                <span>{c.issuer} · {c.year}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact">
      <div class="wrap">
        <p class="section-label" style="justify-content:center">07 / Contact</p>
        <h2>Let's build something.</h2>
        <p>Open to conversations about AI engineering, technical leadership, and hard systems problems.</p>
        <div class="social-row">
          {profile.email && <a class="btn btn-primary" href={`mailto:${profile.email}`}>Email me</a>}
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn" href={profile.links.twitter} target="_blank" rel="noopener">X / Twitter ↗</a>
          <a class="btn" href={profile.links.telegram} target="_blank" rel="noopener">Telegram ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;justify-content:space-between;width:100%">
      <span>© {year} {profile.name}</span>
      <span>Built with Astro · Hosted on GitHub Pages</span>
    </div>
  </footer>
</Base>
