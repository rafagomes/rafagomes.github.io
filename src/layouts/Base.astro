---
import { profile } from '../data/profile.js';
import { jsonLd } from '../lib/seo.js';
import '../styles/global.css';

const {
  title = `${profile.name} — ${profile.title} @ ${profile.company}`,
  description = profile.tagline,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Social previews need a raster image: LinkedIn and X do not render SVG. og.png is
// rendered from public/og.svg with headless Chrome.
const image = ogImage ?? new URL('/og.png', Astro.site).href;
const imageAlt = ogImageAlt ?? `${profile.name}, ${profile.title} at ${profile.company}: 25 engineers, 4 AI agents in production, 1M protocol users.`;

// JSON-LD: Person schema. This is the primary signal AI answer engines and
// search crawlers use to understand who Rafa is. Keep it aligned with profile.js.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: profile.name,
  alternateName: profile.handle,
  jobTitle: profile.title,
  description: profile.tagline,
  url: Astro.site?.href,
  worksFor: {
    '@type': 'Organization',
    name: profile.company,
    url: profile.companyUrl,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rio de Janeiro',
    addressCountry: 'BR',
  },
  knowsAbout: [
    'AI engineering',
    'Agentic AI systems',
    'Multi-agent orchestration',
    'Large language model applications',
    'Agentic AI in production',
    'AI-native engineering teams',
    'Software engineering',
    'Engineering leadership',
    'Distributed systems',
    'Blockchain',
    'Cybersecurity',
    'Go programming language',
    'Rust programming language',
  ],
  knowsLanguage: ['Portuguese', 'English'],
  sameAs: [
    profile.links.github,
    profile.links.linkedin,
    profile.links.twitter,
    profile.links.telegram,
    profile.links.blog,
  ],
  alumniOf: profile.education.map((e) => ({
    '@type': 'EducationalOrganization',
    name: e.issuer,
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${profile.name} — Portfolio`,
  url: Astro.site?.href,
  author: { '@type': 'Person', name: profile.name },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1f3fe0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Inter+Tight:wght@400;700;800&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Rafa" />
        <meta property="profile:last_name" content="Gomes" />
        <meta property="profile:username" content={profile.handle} />
      </>
    )}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content={profile.twitterHandle} />

    <!-- Sitemap link for crawlers -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Writing`} href="/rss.xml" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={jsonLd(personSchema)} />
    <script type="application/ld+json" set:html={jsonLd(websiteSchema)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
