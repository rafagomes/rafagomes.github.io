---
import Base from './Base.astro';
import PageNav from '../components/PageNav.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile.js';
import { postUrl } from '../lib/posts.js';
import { formatDate, isoDate, jsonLd, lastUpdated, pageTitle } from '../lib/seo.js';

const { post, others } = Astro.props;
const { title, description, summary, publishedAt, updatedAt, tags } = post.data;

const url = postUrl(post, Astro.site);
const home = new URL('/', Astro.site).href;
const writing = new URL('/writing/', Astro.site).href;
const image = new URL(`/writing/${post.id}/og.png`, Astro.site).href;
const imageAlt = `${title}, by ${profile.name}`;
const modified = lastUpdated(post.data);
const author = { '@type': 'Person', '@id': `${home}#person`, name: profile.name, url: home };

const postingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image,
  datePublished: publishedAt.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'en',
  keywords: tags.join(', '),
  wordCount: post.body.trim().split(/\s+/).length,
  mainEntityOfPage: url,
  author,
  publisher: author,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: home },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: writing },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<Base
  title={pageTitle(title, profile.name)}
  description={description}
  ogType="article"
  ogImage={image}
  ogImageAlt={imageAlt}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedAt.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    <meta property="article:author" content={home} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="alternate" type="text/markdown" href={`/writing/${post.id}.md`} />
    <script type="application/ld+json" set:html={jsonLd(postingSchema)} />
    <script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />
  </Fragment>

  <a href="#main" class="skip-link">Skip to content</a>
  <div class="wrap"><PageNav /></div>

  <main id="main" class="wrap">
    <article class="post">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/writing/">Writing</a></li>
        </ol>
      </nav>
      <header>
        <h1>{title}</h1>
        <p class="byline">
          By <a href="/" rel="author">{profile.name}</a> · {profile.title} ·
          <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
          {updatedAt && <> · Updated <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt)}</time></>}
        </p>
        <p class="summary">{summary}</p>
      </header>
      <div class="prose"><slot /></div>
      <footer class="post-foot">
        <p class="label">{tags.join(' · ')}</p>
        <p class="bio">{profile.tagline} <a href="/">More about Rafa</a>.</p>
      </footer>
    </article>

    {others.length > 0 && (
      <section class="more-posts" aria-labelledby="more-title">
        <h2 id="more-title">More writing</h2>
        <PostList posts={others} heading="h3" />
      </section>
    )}
  </main>
</Base>
